# Credentials Secret read by the cluster-scoped ProviderConfig (providerconfig.yaml) and the
# ClusterProviderConfig (clusterproviderconfig.yaml). This file only documents the shape. Never
# fill it in inside the repository: a filled copy there can be committed, and
# `crossplane xpkg build --examples-root examples` packs every *.yaml and *.yml file under
# examples/ into the published package. Create the Secret from outside the repository instead,
# with the password typed at a prompt and passed through stdin (never on a command line, where
# `ps` shows it):
#
#   read -rs VSPHERE_PASSWORD
#   printf '%s' "$VSPHERE_PASSWORD" | jq -cn --rawfile password /dev/stdin \
#       --arg user administrator@vsphere.local --arg vsphere_server vcenter.example.com \
#       '{user: $user, password: $password, vsphere_server: $vsphere_server, allow_unverified_ssl: "true"}' |
#     kubectl -n crossplane-system create secret generic example-creds --from-file=credentials=/dev/stdin
#   unset VSPHERE_PASSWORD
#
# Or edit a private copy in a temporary file (mktemp creates it mode 0600), apply it, delete it:
#
#   f=$(mktemp) && cp examples/providerconfig/secret.yaml.tmpl "$f" && "${EDITOR:-vi}" "$f" &&
#     kubectl apply -f "$f"; rm -f "$f"
#
# The credentials key holds one JSON object:
# - user, password and vsphere_server are required strings.
# - allow_unverified_ssl may be a JSON boolean (true) or a string ("true").
# - api_timeout may be a JSON number (5) or a string ("5").
# Pioneer sends every value as a string, including "allow_unverified_ssl": "true".
# The login key is "user". The previous example used "username", which was wrong: the
# provider ignores it and reports the missing "user" key.
apiVersion: v1
kind: Secret
metadata:
  name: example-creds
  namespace: crossplane-system
type: Opaque
stringData:
  credentials: |
    {
      "user": "administrator@vsphere.local",
      "password": "REPLACE_WITH_PASSWORD",
      "vsphere_server": "vcenter.example.com",
      "allow_unverified_ssl": "true",
      "api_timeout": 5
    }
