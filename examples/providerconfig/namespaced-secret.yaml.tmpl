# Credentials Secret read by the namespaced ProviderConfig (namespaced-providerconfig.yaml).
# A namespaced ProviderConfig always reads its Secret from the namespace of the managed resource
# that uses it, so this Secret must live in the same namespace as that ProviderConfig and its
# MRs ("default" here).
#
# This file only documents the shape. Never fill it in inside the repository: a filled copy
# there can be committed, and `crossplane xpkg build --examples-root examples` packs every *.yaml
# and *.yml file under examples/ into the published package. Create the Secret from outside the
# repository, with the password typed at a prompt and passed through stdin (never on a command
# line):
#
#   read -rs VSPHERE_PASSWORD
#   printf '%s' "$VSPHERE_PASSWORD" | jq -cn --rawfile password /dev/stdin \
#       --arg user administrator@vsphere.local --arg vsphere_server vcenter.example.com \
#       '{user: $user, password: $password, vsphere_server: $vsphere_server, allow_unverified_ssl: "true"}' |
#     kubectl -n default create secret generic example-creds --from-file=credentials=/dev/stdin
#   unset VSPHERE_PASSWORD
#
# Or edit a private copy in a temporary file (mktemp creates it mode 0600), apply it, delete it:
#
#   f=$(mktemp) && cp examples/providerconfig/namespaced-secret.yaml.tmpl "$f" &&
#     "${EDITOR:-vi}" "$f" && kubectl apply -f "$f"; rm -f "$f"
#
# Same keys as secret.yaml.tmpl: user, password and vsphere_server are required strings;
# allow_unverified_ssl may be a JSON boolean or a string; api_timeout may be a JSON number or a
# string. The login key is "user" (not "username").
apiVersion: v1
kind: Secret
metadata:
  name: example-creds
  namespace: default
type: Opaque
stringData:
  credentials: |
    {
      "user": "administrator@vsphere.local",
      "password": "REPLACE_WITH_PASSWORD",
      "vsphere_server": "vcenter.example.com",
      "allow_unverified_ssl": "true",
      "api_timeout": 5
    }
